# LearnHouse — Aloysius College deployment
# Copy to .env.production, then fill in the required secrets.
#   cp .env.production.example .env.production
#
# Generate secrets with:  openssl rand -hex 32
# Both secrets below MUST be >= 32 chars. The collab service calls
# process.exit(1) on a missing, placeholder, or too-short value.

# =============================================================================
# Required secrets — compose refuses to start without these
# =============================================================================
# openssl rand -hex 32
LEARNHOUSE_AUTH_JWT_SECRET_KEY=

# openssl rand -hex 32
# Not present in upstream env.example, but the collab service hard-fails without it.
COLLAB_INTERNAL_KEY=

# openssl rand -hex 32
NEXTAUTH_SECRET=

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Change before first boot. The API only uses these when creating the first admin.
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@aloysiuscollege.lk
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=

# =============================================================================
# Domain
# =============================================================================
LEARNHOUSE_DOMAIN=lms.aloysiuscollege.lk
LEARNHOUSE_FRONTEND_DOMAIN=lms.aloysiuscollege.lk
LEARNHOUSE_SSL=True

NEXT_PUBLIC_LEARNHOUSE_API_URL=https://lms.aloysiuscollege.lk/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://lms.aloysiuscollege.lk/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=lms.aloysiuscollege.lk
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=aloysiuscollege.lk
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=aloysiuscollege

# =============================================================================
# Security — READ THIS
# =============================================================================
# The shipped default is a catch-all regex, which leaves CORS and CSRF
# effectively open to any origin. Scope it to your own domain.
LEARNHOUSE_ALLOWED_REGEXP=^https://(?:[a-z0-9-]+\.)*aloysiuscollege\.lk$

# 'multi' (slug.subdomain tenancy) requires the Enterprise Edition, which is
# not in this image. Leave this as single.
LEARNHOUSE_TENANCY=single

LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_COOKIE_DOMAIN=.aloysiuscollege.lk

# =============================================================================
# Infrastructure
# =============================================================================
POSTGRES_USER=learnhouse
POSTGRES_DB=learnhouse
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_PORT=9000
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# =============================================================================
# Branding (config-only, no rebuild needed)
# =============================================================================
LEARNHOUSE_SITE_NAME=Aloysius College
LEARNHOUSE_CONTACT_EMAIL=admin@aloysiuscollege.lk
LEARNHOUSE_SITE_DESCRIPTION=Learning platform for Aloysius College.

# =============================================================================
# AI — Ollama. Base URL must be reachable FROM the container.
# If Ollama runs on the same host, use host.docker.internal (Linux: add
# extra_hosts: ["host.docker.internal:host-gateway"]).
# =============================================================================
LEARNHOUSE_IS_AI_ENABLED=True
LEARNHOUSE_AI_PROVIDER=ollama
LEARNHOUSE_AI_BASE_URL=http://host.docker.internal:11434/v1
LEARNHOUSE_AI_MODEL_FAST=llama3.2:1b
LEARNHOUSE_AI_MODEL_STANDARD=llama3.1:8b
LEARNHOUSE_AI_MODEL_PRO=llama3.1:8b
LEARNHOUSE_AI_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Email — required for password reset / verification links to work
# =============================================================================
# LEARNHOUSE_EMAIL_PROVIDER=smtp
# LEARNHOUSE_SMTP_HOST=
# LEARNHOUSE_SMTP_PORT=587
# LEARNHOUSE_SMTP_USERNAME=
# LEARNHOUSE_SMTP_PASSWORD=
# LEARNHOUSE_SMTP_USE_TLS=True
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=